generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id             Int              @id @default(autoincrement())
  title          String
  description    String?
  dueDate        String?          // YYYY-MM-DD (start date for recurring)
  time           String?          // HH:MM
  endTime        String?          // HH:MM
  completed      Boolean          @default(false)
  completedAt    String?          // YYYY-MM-DD (non-recurring only)
  recurringType  String?          // null | daily | weekdays | weekends | weekly | monthly
  recurringDays  String?          // comma-separated day indices 0-6 (for weekly type)
  recurringEnd   String?          // YYYY-MM-DD end date (null = forever)
  weight         Int              @default(1) // 1=normal, 2=important, 3=critical
  kind           String?          // meeting | focus | personal | admin | planning — UI tag for color stripes
  active         Boolean          @default(true)
  deletedAt      String?          // YYYY-MM-DD — set on soft-delete to preserve history
  createdAt      DateTime         @default(now())
  completions    TaskCompletion[]
  skips          TaskSkip[]
}

model TaskCompletion {
  id      Int    @id @default(autoincrement())
  taskId  Int
  date    String // YYYY-MM-DD
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
}

model TaskSkip {
  id     Int    @id @default(autoincrement())
  taskId Int
  date   String // YYYY-MM-DD
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
}

model Habit {
  id             Int               @id @default(autoincrement())
  name           String
  description    String?
  active         Boolean           @default(true)
  recurringDays  String?           // null = every day; "1,2,3,4,5" = weekdays; "0,6" = weekends; custom
  weight         Int               @default(1) // 1=normal, 2=important, 3=critical
  startDate      String?           // YYYY-MM-DD local date when habit was created
  createdAt      DateTime          @default(now())
  completions    HabitCompletion[]
  skips          HabitSkip[]
}

model Scratchpad {
  id        Int      @id @default(1)
  notes     String   @default("")
  checklist String   @default("[]") // JSON: [{id,text,done}]
  updatedAt DateTime @updatedAt
}

model DayNote {
  id        Int      @id @default(autoincrement())
  date      String   @unique // YYYY-MM-DD
  content   String
  updatedAt DateTime @updatedAt
}

model HabitCompletion {
  id      Int    @id @default(autoincrement())
  habitId Int
  date    String // YYYY-MM-DD
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model HabitSkip {
  id      Int    @id @default(autoincrement())
  habitId Int
  date    String // YYYY-MM-DD
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model LiftEntry {
  id        Int      @id @default(autoincrement())
  date      String   // YYYY-MM-DD
  name      String
  weight    Float
  sets      String   // JSON: [8,10,8] — reps per set
  totalReps Int
  createdAt DateTime @default(now())
}

model LiftGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  exercises String   @default("[]") // JSON: ["Bench Press", "Squat"]
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Project {
  id        Int      @id @default(autoincrement())
  title     String
  notes     String   @default("")
  checklist String   @default("[]") // JSON: [{id,text,done}]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Health (Apple Watch via Health Auto Export) ────────────────────────────
// Additive-only: nothing above this line was modified. Dropping these four
// tables is the complete DB rollback. Baselines are computed on the fly, so
// there is no baseline table to keep in sync.

// One row per (day, metric). `metric` is HAE's own metric name, stored
// verbatim so an unrecognised metric is still persisted rather than dropped.
model HealthMetricDaily {
  id     Int     @id @default(autoincrement())
  date   String // YYYY-MM-DD (local day)
  metric String // HAE name, e.g. "heart_rate_variability"
  qty    Float? // sum/total-style metrics (steps, active_energy)
  min    Float?
  avg    Float?
  max    Float?
  units  String?

  @@unique([date, metric])
  @@index([date])
}

// One row per raw Apple Health reading, as delivered by Health Auto Export
// with "Aggregate Data" OFF.
//
// This table exists for exactly one reason: recovery has to be scored on
// SLEEP-WINDOW physiology, and a daily aggregate cannot express "your HRV
// while you were asleep". With per-reading timestamps, the readings inside
// last night's sleep window can be selected and scored, and the answer stops
// changing the moment you wake up — which is the whole point. See
// RECOVERY_LIMIT in lib/health.ts for the measurement that forced this.
//
// It deliberately does NOT feed steps or active energy. Both the iPhone and
// the Watch record those, Apple de-duplicates overlapping sources when it
// reports a daily total, and summing raw per-source samples would overshoot.
// Volume metrics come from the aggregated daily rows above; this table carries
// heart rate and HRV, which only the Watch records.
model HealthSample {
  id     Int     @id @default(autoincrement())
  metric String // normalised HAE name, e.g. "heart_rate_variability"
  date   String // YYYY-MM-DD local day of `start`, for range queries
  start  String // raw HAE timestamp, verbatim
  // `source` is part of the identity, not decoration: two devices can record
  // the same metric at the same instant, and collapsing them onto one key
  // would silently drop one device's reading.
  source String  @default("")
  qty    Float?
  min    Float?
  avg    Float?
  max    Float?
  units  String?

  @@unique([metric, start, source])
  @@index([date, metric])
}

// One row per night, keyed on the WAKE day — matching how Bevel and Apple
// Health both attribute a night's sleep.
model SleepSession {
  id        Int     @id @default(autoincrement())
  date      String  @unique // YYYY-MM-DD wake day
  start     String? // ISO timestamp as delivered
  end       String?
  inBedMin  Float?
  asleepMin Float?
  coreMin   Float?
  deepMin   Float?
  remMin    Float?
  awakeMin  Float?
  raw       String? // original JSON, so a parser fix can reprocess history

  // Physiology measured INSIDE this night's window, derived from HealthSample
  // at import time. Stored rather than computed per request because the query
  // that produces them reads several hundred readings per night, and every
  // page load would otherwise re-read months of them to draw one ring.
  //
  // `sleepHr` is the quantity Bevel reports as your sleeping bpm — mean heart
  // rate across the window, matched to 0.10 bpm over nine nights.
  sleepHr   Float?
  sleepHrv  Float?
  sleepResp Float?
  // Readings behind each mean. Zero is meaningful: it says the watch recorded
  // nothing that night, which is not the same as a bad night.
  hrN       Int     @default(0)
  hrvN      Int     @default(0)
  respN     Int     @default(0)
}

// One row per authenticated import. Exists because "did the automation
// actually run?" was otherwise unanswerable: a successful import that carries
// unchanged data writes identical values, so comparing the data cannot
// distinguish "ran and no-op'd" from "never ran". Only the request itself is
// evidence.
//
// Unauthenticated requests are deliberately NOT logged — an endpoint that
// writes a row for anyone who can reach it is a free disk-fill.
model HealthImportLog {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  ok       Boolean  @default(true)
  metrics  Int      @default(0)
  sleep    Int      @default(0)
  workouts Int      @default(0)
  skipped  Int      @default(0)
  // Day range covered by the payload, e.g. "2026-08-01 → 2026-08-07"
  span     String?
  // Failure reason or parser warnings, truncated
  note     String?

  @@index([at])
}

// `externalId` is HAE's workout id — the idempotency key. Re-POSTing the same
// export updates in place instead of duplicating.
model HealthWorkout {
  id          Int     @id @default(autoincrement())
  externalId  String  @unique
  date        String // YYYY-MM-DD (local day of start)
  type        String
  start       String?
  end         String?
  durationMin Float?
  activeKcal  Float?
  avgHr       Float?
  maxHr       Float?
  distanceKm  Float?
  raw         String?

  @@index([date])
}
